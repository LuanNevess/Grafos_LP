digraph DFS {
  A [style=filled, fillcolor=gold, penwidth=2.0, label="A (1º - Raiz, p=0)"];
  B [style=filled, fillcolor=lightblue, label="B (2º, p=1)"];
  C [style=filled, fillcolor=lightblue, label="C (3º, p=2)"];
  D [style=filled, fillcolor=lightblue, label="D (5º, p=2)"];
  E [style=filled, fillcolor=lightblue, label="E (4º, p=3)"];
  A -> A [color=gray, style=dashed];
  A -> B [color=blue, penwidth=2.5];
  B -> C [color=blue, penwidth=2.5];
  C -> A [color=gray, style=dashed];
  B -> D [color=blue, penwidth=2.5];
  B -> D [color=gray, style=dashed];
  C -> E [color=blue, penwidth=2.5];
}